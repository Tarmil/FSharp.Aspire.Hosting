source https://api.nuget.org/v3/index.json
storage none
strategy min
lowest_matching true

nuget Aspire.Hosting >= 13.0
nuget Aspire.Hosting.AppHost >= 13.0
nuget Aspire.Hosting.AWS >= 13.0
nuget Aspire.Hosting.Azure >= 13.0
nuget Aspire.Hosting.Orleans >= 13.0
nuget Aspire.Hosting.SqlServer >= 13.0
nuget FSharp.Core >= 10.0
nuget Microsoft.Extensions.ServiceDiscovery >= 10.0
nuget Microsoft.SourceLink.GitHub 10.0.301 copy_local: true
nuget System.Text.Json >= 10.0.3
nuget Microsoft.IdentityModel.Abstractions >= 8.6

// Minimum versions for vulnerabilities
nuget Amazon.CDK.Lib >= 2.253.0
nuget MessagePack >= 2.5.303
nuget Microsoft.Build.Tasks.Git >= 10.0.303
nuget System.Security.Cryptography.Pkcs >= 10.0.13
